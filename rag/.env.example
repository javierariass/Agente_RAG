# Copia este archivo como .env y ajusta la IP de la maquina con Ollama.
# Esta API corre en la PC "agente"; Ollama corre en OTRA PC de la red.
OLLAMA_HOST=172.18.201.201
OLLAMA_PORT=11434
# OLLAMA_URL=http://172.18.201.201:11434/v1
OLLAMA_MODEL=qwen3.6:27b
# OLLAMA_API_KEY=ollama
# OLLAMA_TIMEOUT=60

# Embeddings: modelo multilingue (funciona bien con documentos en espanol).
# Si se cambia, el cache se invalida y se reindexa automaticamente.
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Dispositivo para embeddings: "auto" usa CUDA (RTX) si esta disponible y si
# no, CPU. Se recomienda dejar "auto"; no hace falta configurar nada.
# EMBEDDING_DEVICE=auto

# Cada cuantos segundos se comprueba si la carpeta data/ cambio para
# reindexar automaticamente en segundo plano (no requiere reiniciar).
# REINDEX_WATCH_SECONDS=30

# Puertos publicados por PM2 (api y web) - 0.0.0.0 = accesible en la LAN
API_HOST=0.0.0.0
API_PORT=3090
WEB_HOST=0.0.0.0
WEB_PORT=4000
